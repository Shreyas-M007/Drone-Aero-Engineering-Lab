{
  "name": "aero-lab",
  "version": "1.0.0",
  "description": "Aero Lab — Build DJI-referenced quadcopters and fly them in AR room scans or AAA city sandbox environments.",
  "main": "main.js",
  "scripts": {
    "start": "npx esbuild app.js --bundle --outfile=bundle.js --format=esm && electron .",
    "build:win": "npx esbuild app.js --bundle --outfile=bundle.js --format=esm && electron-builder --win",
    "build:mac": "npx esbuild app.js --bundle --outfile=bundle.js --format=esm && electron-builder --mac",
    "build:all": "npx esbuild app.js --bundle --outfile=bundle.js --format=esm && electron-builder --win --mac"
  },
  "build": {
    "appId": "com.aerolab.drone-simulator",
    "productName": "Aero Lab",
    "files": [
      "main.js",
      "index.html",
      "index.css",
      "bundle.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null,
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.simulation-games"
    },
    "portable": {
      "artifactName": "AeroLab-${version}-Setup.exe"
    }
  },
  "author": "Shreyas M",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "three": "0.160.0"
  }
}
